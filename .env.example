# Local dev: SQLite database file lives in ./database (git-ignored)
SS_DATABASE_CLASS="SQLite3Database"
SS_DATABASE_NAME="pennymirror"
SS_SQLITE_DATABASE_PATH="database"
SS_DATABASE_SERVER="none"
SS_DATABASE_USERNAME="none"
SS_DATABASE_PASSWORD="none"

SS_ENVIRONMENT_TYPE="dev"

# Default admin created on first db build (dev only)
SS_DEFAULT_ADMIN_USERNAME="admin"
SS_DEFAULT_ADMIN_PASSWORD="password"
