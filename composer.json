{
    "name": "binfan/pennymirror",
    "type": "silverstripe-recipe",
    "description": "PennyMirror: fact-based research pages for small-cap US stocks, built on Silverstripe CMS 6",
    "license": "BSD-3-Clause",
    "require": {
        "php": "^8.3",
        "silverstripe/recipe-plugin": "~2.1.0@stable",
        "silverstripe/vendor-plugin": "~3.0.0@stable",
        "silverstripe/recipe-cms": "~6.2.0@stable",
        "silverstripe/startup-theme": "~1.0.12@stable",
        "silverstripe/login-forms": "~6.2.0@stable",
        "silverstripe/htmleditor-tinymce": "~1.1.0@stable",
        "guzzlehttp/guzzle": "^7.9",
        "symbiote/silverstripe-queuedjobs": "^6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.3"
    },
    "extra": {
        "project-files-installed": [
            ".htaccess",
            "app/.htaccess",
            "app/_config/mimevalidator.yml",
            "app/_config/mysite.yml",
            "app/src/Page.php",
            "app/src/PageController.php"
        ],
        "public-files-installed": [
            ".htaccess",
            "index.php",
            "web.config"
        ],
        "expose": [
            "app/client"
        ]
    },
    "config": {
        "process-timeout": 600,
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/recipe-plugin": true,
            "silverstripe/vendor-plugin": true
        }
    },
    "prefer-stable": true,
    "minimum-stability": "dev",
    "scripts": {
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "php -S localhost:8080 -t public dev/router.php"
        ]
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/src/"
        },
        "classmap": [
            "app/src/Page.php",
            "app/src/PageController.php"
        ]
    }
}
